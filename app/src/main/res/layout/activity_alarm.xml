<?xml version="1.0" encoding="utf-8"?>
<!-- 잠금화면 위 알람 화면 (v1.2) — 큰 시각 + 길게 눌러 끄기 + 5분 뒤 다시 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="58dp"
    android:paddingEnd="24dp"
    android:paddingBottom="26dp">

    <TextView
        android:id="@+id/alarmBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="@string/alarm_badge"
        android:textColor="@color/amber"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="--:--"
        android:textColor="@color/txt"
        android:textSize="76sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/app_name"
        android:textColor="@color/txt"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text=""
        android:textColor="@color/dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/alarmHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/alarm_hint"
        android:textColor="@color/dim2"
        android:textSize="12sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 길게 눌러 끄기: 누르는 동안 채워지고, 다 채워지면 알람이 꺼진다 -->
    <FrameLayout
        android:id="@+id/stopBox"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/bg_pill_amber"
        android:clipToOutline="true"
        android:clickable="true"
        android:contentDescription="@string/btn_stop_hold"
        android:focusable="true">

        <View
            android:id="@+id/stopFill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/amber_fill" />

        <TextView
            android:id="@+id/stopLabel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="@string/btn_stop_hold"
            android:textColor="#101724"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <Button
        android:id="@+id/btnSnooze"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_dark"
        android:stateListAnimator="@null"
        android:text="@string/btn_snooze"
        android:textAllCaps="false"
        android:textColor="@color/txt"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmPermNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/amber2"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnUnlock"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        android:text="@string/btn_unlock"
        android:textAllCaps="false"
        android:textColor="@color/dim"
        android:textSize="13sp" />
</LinearLayout>
